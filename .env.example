# Local laptop catalog (SD#11.11). Coolify uses deploy/coolify-app-env.example.
# Boot validation: packages/shared loadServerEnv (web instrumentation + worker).

DATABASE_URL=postgresql://emailhub_app:emailhub@127.0.0.1:5432/emailhub
DATABASE_MIGRATION_URL=postgresql://emailhub:emailhub@127.0.0.1:5432/emailhub
CLICKHOUSE_URL=http://localhost:8123
REDIS_URL=redis://:emailhub@localhost:6379

# Omit or use `dev` locally. Droplet Prod must use `prod` (MAIL_TRANSPORT=ses, no E2E).
EMAILHUB_ENV=dev

BETTER_AUTH_SECRET=dev-better-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=admin@bigdropsmarketing.com

SES_REGION=us-east-1
SES_CONFIGURATION_SET=
SES_MAX_SEND_RATE=14
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

# Never set on Prod. Local Playwright only: E2E=1
# E2E=

SNS_TOPIC_ARN=

OPTIZMO_API_KEY=

GOOGLE_POSTMASTER_CLIENT_ID=
GOOGLE_POSTMASTER_CLIENT_SECRET=
GOOGLE_POSTMASTER_REFRESH_TOKEN=
SNDS_KEY=

IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

BLOCKLISTS=zen.spamhaus.org

APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
UNSUBSCRIBE_TOKEN_SECRET=dev-unsubscribe-token-secret-change-me

SENTRY_DSN=
