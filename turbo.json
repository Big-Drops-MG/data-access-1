{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_MIGRATION_URL",
    "CLICKHOUSE_URL",
    "REDIS_URL",
    "NODE_ENV",
    "LOG_LEVEL",
    "LOG_FORMAT",
    "NEXT_RUNTIME",
    "EMAILHUB_ENV",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "ADMIN_EMAILS",
    "MAIL_TRANSPORT",
    "SMTP_HOST",
    "SMTP_PORT",
    "SES_REGION",
    "SES_CONFIGURATION_SET",
    "SES_MAX_SEND_RATE",
    "SES_FROM_EMAIL",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "SNS_TOPIC_ARN",
    "E2E",
    "E2E_AUTH_SECRET",
    "E2E_TOTP_SECRET",
    "E2E_LOGIN_EMAIL",
    "E2E_2FA_EMAIL",
    "E2E_LOCKOUT_EMAIL",
    "E2E_DATABASE_NAME",
    "E2E_ENVIRONMENT",
    "PLAYWRIGHT_BASE_URL",
    "CI",
    "SENTRY_DSN",
    "VITEST",
    "UNSUBSCRIBE_TOKEN_SECRET",
    "FBL_WEBHOOK_SECRET",
    "EVERFLOW_API_KEY",
    "EVERFLOW_API_BASE_URL",
    "OPTIZMO_API_KEY",
    "APP_ENCRYPTION_KEY",
    "CATALOG_SEED_ACTOR_EMAIL",
    "RECIPIENT_IMPORTS_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
