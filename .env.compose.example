# Copy to .env.compose on the droplet (mode 600). Never commit real values.
# Coolify can inject the same keys instead of a file.
# App secrets for web/worker: also load deploy/coolify-app-env.example into Coolify.

APP_HOST=emailhub-dev.dataaccess1.com
ACME_EMAIL=ops@example.com
APP_IMAGE=ghcr.io/OWNER/REPO:git-sha
EMAILHUB_ENV=dev

POSTGRES_USER=emailhub
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=emailhub

REDIS_PASSWORD=replace-me
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-me

# App connects over the Compose network (service DNS names). Use sslmode only for remote hosts.
# DATABASE_URL is the app role. DATABASE_MIGRATION_URL is the owner login for db:migrate.
# Do not pass DATABASE_MIGRATION_URL into the web or worker containers.
DATABASE_MIGRATION_URL=postgresql://emailhub:replace-me@postgres:5432/emailhub
DATABASE_URL=postgresql://emailhub_app:replace-me@postgres:5432/emailhub
REDIS_URL=redis://:replace-me@redis:6379
CLICKHOUSE_URL=http://default:replace-me@clickhouse:8123
