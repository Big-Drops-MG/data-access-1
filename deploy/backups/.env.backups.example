EMAILHUB_ENV=dev

S3_BUCKET=emailhub-backups
S3_REGION=fsn1
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=backups/dev

AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Private key path only for restore drills (never commit). Prefer keeping it offline.
# AGE_IDENTITY_FILE=/etc/emailhub/age/backup.key

# Retention
PG_DAILY_KEEP=30
PG_MONTHLY_KEEP=12
CH_DAILY_KEEP=14
SNAPSHOT_KEEP=4

HCLOUD_TOKEN=

