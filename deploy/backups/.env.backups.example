# Host-only secrets for T-105 / SD#13.8. Install as /etc/emailhub/backups.env (mode 600).
# Never commit real values.

EMAILHUB_ENV=dev
# prod droplet uses /opt/emailhub/.env.compose; dev uses /opt/emailhub-dev/.env.compose
# COMPOSE_ENV_FILE=/opt/emailhub-dev/.env.compose

# DigitalOcean Spaces (same bucket as Terraform state; separate key prefix)
SPACES_BUCKET=emailhub-da1-tfstate
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_PREFIX=backups/dev

# age public recipient (private key stays offline for restores)
# Generate: age-keygen -o age-backup.key
AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Retention
PG_DAILY_KEEP=30
PG_MONTHLY_KEEP=12
CH_DAILY_KEEP=14
SNAPSHOT_KEEP=4

# Optional overrides
# POSTGRES_CONTAINER=emailhub-dev-postgres-1
# CLICKHOUSE_CONTAINER=emailhub-dev-clickhouse-1
# WORK_DIR=/var/tmp/emailhub-backups
# CH_BACKUP_IMAGE=altinity/clickhouse-backup:2.6.24

# Weekly droplet snapshot (DigitalOcean API)
DO_API_TOKEN=
# DO_DROPLET_ID=
# EMAILHUB_DROPLET_NAME=
