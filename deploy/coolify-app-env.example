# Coolify encrypted environment for EmailHub web + worker (SD#11.11 / T-033).
# Copy these keys into Coolify (Dev and Prod). Never commit real values.
# Compose host keys (.env.compose) stay separate; this list is what the app containers need.

# Deploy target: `dev` (Mailpit/SMTP allowed) or `prod` (requires MAIL_TRANSPORT=ses, no E2E)
EMAILHUB_ENV=dev

DATABASE_URL=postgresql://emailhub_app:replace-me@postgres:5432/emailhub
REDIS_URL=redis://:replace-me@redis:6379
CLICKHOUSE_URL=http://default:replace-me@clickhouse:8123

BETTER_AUTH_SECRET=replace-me-32+-chars
BETTER_AUTH_URL=https://emailhub-dev.dataaccess1.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=admin@bigdropsmarketing.com

# Dev default: smtp → Mailpit. Prod: ses (required) and leave E2E unset.
MAIL_TRANSPORT=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025

SES_REGION=us-east-1
SES_CONFIGURATION_SET=
SES_MAX_SEND_RATE=14
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SNS_TOPIC_ARN=
OPTIZMO_API_KEY=
GOOGLE_POSTMASTER_CLIENT_ID=
GOOGLE_POSTMASTER_CLIENT_SECRET=
GOOGLE_POSTMASTER_REFRESH_TOKEN=
SNDS_KEY=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
BLOCKLISTS=zen.spamhaus.org

APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
UNSUBSCRIBE_TOKEN_SECRET=replace-me

SENTRY_DSN=

# Do not set E2E on Prod. Local/E2E only: E2E=1
