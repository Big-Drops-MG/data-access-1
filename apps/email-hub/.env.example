# Local Postgres only. A non-loopback host must use sslmode=verify-full.
# App login: no superuser. audit_log is insert and select only.
DATABASE_URL=postgresql://emailhub_app:emailhub@127.0.0.1:5433/emailhub
# Owner login used by migrations. Do not use this as DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://emailhub:emailhub@127.0.0.1:5433/emailhub
CLICKHOUSE_URL=http://default:emailhub@127.0.0.1:8123
REDIS_URL=redis://:emailhub@127.0.0.1:6379

# Pino level: fatal, error, warn, info, debug, trace, silent. Invalid values fall back to info.
LOG_LEVEL=info
# pretty is ignored when EMAILHUB_ENV=prod or NODE_ENV=production. Default is JSON.
# LOG_FORMAT=pretty

# Required when MAIL_TRANSPORT=smtp (default). Use Mailpit from docker-compose.dev.yml.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

# SES event topic. POST /api/ext/webhooks/ses rejects every other topic.
SNS_TOPIC_ARN=

# Cloudflare DNS (auto-create SES records on domain create). Token needs Zone.DNS Edit.
CLOUDFLARE_API_TOKEN=
# Optional. If empty, the zone is resolved from the domain (e.g. quotifii.com).
CLOUDFLARE_ZONE_ID=

# Local CSV import storage. Docker defaults to /data/imports.
# RECIPIENT_IMPORTS_DIR=D:/data-access-1/.data/imports
