# Local development reaches DigitalOcean Postgres through an SSH tunnel.
# 127.0.0.1:15432 is the tunnel on this machine. SSH encrypts that path.
# Do not put the public server address here. A non-loopback host must set sslmode=verify-full.
DATABASE_URL=postgresql://emailhub_user:PASSWORD@127.0.0.1:15432/emailhub

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=emailhub

REDIS_URL=redis://localhost:6379

SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_URL=http://localhost:8025

BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SENTRY_DSN=
