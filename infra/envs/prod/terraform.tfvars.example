# Copy to terraform.tfvars (gitignored) and fill in.
ssh_key_ids = [
  # DigitalOcean SSH key id or fingerprint from:
  #   doctl compute ssh-key list
]

# Tighten before Prod apply (defaults are world-open for early bootstrap only):
# ssh_allowed_cidrs = ["203.0.113.10/32"]

# Optional overrides (defaults match SD#13.1 Prod):
# droplet_size    = "s-4vcpu-16gb-amd"
# volume_size_gb  = 100
# region          = "nyc3"

# T-039 — AWS SES / SNS / SQS + Cloudflare DNS (env credentials, not files):
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (or a role)
#   CLOUDFLARE_API_TOKEN (Zone.DNS Edit)
# aws_region            = "us-east-1"
# cloudflare_zone_id    = "your-zone-id"
# app_hostname          = "emailhub.dataaccess1.com"
# app_dns_name          = "emailhub"
# enable_aws_ses        = true
# enable_cloudflare_dns = true
