{
  "name": "@workspace/emails",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./render": {
      "types": "./src/render-email.ts",
      "default": "./dist/render-email.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "verify:render": "node --import tsx scripts/verify-t054-render.ts",
    "mail:test": "node --env-file=../../.env --import tsx scripts/send-dev-mail.ts",
    "mail:check:ses": "node --env-file=../../.env --import tsx scripts/check-ses.ts",
    "mail:test:ses": "node --env-file=../../.env --import tsx scripts/check-ses.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workspace/config": "workspace:*",
    "eslint": "^10",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@workspace/logger": "workspace:*",
    "@aws-sdk/client-sesv2": "^3.1161.0",
    "@babel/parser": "^8.0.10",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "nodemailer": "^10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.5"
  }
}
