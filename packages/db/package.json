{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "browser": "./dist/client.browser.js",
      "default": "./dist/client.js"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    },
    "./clickhouse": {
      "types": "./src/clickhouse/index.ts",
      "browser": "./dist/clickhouse/client.browser.js",
      "default": "./dist/clickhouse/index.js"
    },
    "./test": {
      "types": "./test/index.ts",
      "default": "./test/index.ts"
    }
  },
  "files": [
    "dist",
    "clickhouse"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:ch:migrate": "tsx src/clickhouse/migrate-cli.ts",
    "db:migrate": "tsx src/migrate-cli.ts && tsx src/app-role-cli.ts && pnpm db:ch:migrate",
    "db:seed": "tsx src/dev-seed-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@workspace/config": "workspace:*",
    "auth": "^1.7.10",
    "better-auth": "^1.7.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "uuid": "^14.0.3"
  }
}
