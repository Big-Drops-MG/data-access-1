{
  "name": "@workspace/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./recipient-csv-ingest": {
      "types": "./src/recipient-csv-ingest.ts",
      "default": "./dist/recipient-csv-ingest.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@workspace/config": "workspace:*",
    "eslint": "^10",
    "msw": "^2.7.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "@workspace/logger": "workspace:*",
    "bullmq": "^5.81.5",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "zod": "^4.6.7"
  }
}
